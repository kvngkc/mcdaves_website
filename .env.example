# =============================================================================
# McDaves Environment Variables — Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git. It is listed in .gitignore.
#
# Get values from:
#   Supabase:  https://supabase.com/dashboard/project/_/settings/api
#   Paystack:  https://dashboard.paystack.com/#/settings/developers
#   Formspree: https://formspree.io/forms
#   GA4:       https://analytics.google.com
# =============================================================================

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://mcdaves.com.ng

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional webhook secret override:
# PAYSTACK_WEBHOOK_SECRET=

# ─── Formspree ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
NEXT_PUBLIC_FORMSPREE_B2B_ID=
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_ID=

# ─── Google Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Admin Authentication ───────────────────────────────────────────────────
ADMIN_PASSKEY=
ADMIN_SESSION_SECRET=

# ─── Supabase Production / Application ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase Test Database ─────────────────────────────────────────────────
# REQUIRED for tests/gate3_db_integrity.test.ts and
# tests/gate4_vto_integration.test.ts. MUST point to a separate test project.
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
