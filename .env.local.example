# ─── McDaves Starter — Required Environment Variables ───────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Paystack ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsk_xxx

# ─── Admin Auth ────────────────────────────────────────────────────────────
# Choose a strong, unique passkey and session secret. Do NOT reuse across envs.
ADMIN_PASSKEY=choose-a-strong-random-passkey
ADMIN_SESSION_SECRET=choose-a-strong-random-signing-secret

# ─── Public Base URL ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://mcdaves.com

# ─── Analytics (Optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
